<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.TextPic" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:windowBackground">@color/bg_canvas</item>
        <item name="android:navigationBarColor">@color/bg_canvas</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>

    <style name="Theme.TextPic.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/bg_canvas</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.TextPic</item>
    </style>

    <style name="Theme.TextPic.Transparent" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>
</resources>
